<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.drakescraft.suites</groupId>
    <artifactId>drakes-suites</artifactId>
    <version>2.0.0-26.X-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Drakes-Suites</name>
    <description>Consolidación Monorepo de 160+ Plugins en 8 Mega-Suites Oficiales para DrakesCraft (Purpur 26.2 / Porteo 26.X)</description>

    <modules>
        <module>drakes-core</module>
        <module>drakes-tech</module>
        <module>drakes-bio</module>
        <module>drakes-magic</module>
        <module>drakes-generators</module>
        <module>drakes-utility</module>
        <module>drakes-combat</module>
        <module>drakes-server</module>
        <module>drakes-multiverse</module>
    </modules>

    <properties>
        <!-- 26.x is the Season 2 branch. Its default artifact must target JDK 25. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <mc.version>26.2</mc.version>
        <purpur.version>26.2.build.+</purpur.version>
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <slimefun.version>RC-37</slimefun.version>
        <dough.version>1.2.0</dough.version>
        <sefilib.version>0.3.1-DRAKE-SNAPSHOT</sefilib.version>
        <infinitylib.version>1.3.11-DRAKE-SNAPSHOT</infinitylib.version>
        <lombok.version>1.18.46</lombok.version>
        <jsr305.version>3.0.2</jsr305.version>
        <junit.version>6.1.2</junit.version>
        <mockbukkit.version>4.110.0</mockbukkit.version>
        <mockbukkit.artifactId>mockbukkit-v1.21</mockbukkit.artifactId>
        <surefire.version>3.5.6</surefire.version>
        <plugin.api.version>1.21</plugin.api.version>
    </properties>

    <repositories>
        <repository>
            <id>purpur</id>
            <url>https://repo.purpurmc.org/snapshots</url>
        </repository>
        <repository>
            <id>drakescraft-maven</id>
            <url>https://maven.drakescraft.cl</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

